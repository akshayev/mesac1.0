# Application Environment Variables
# Example:
# VITE_APP_URL=http://localhost:3000

# Copy to .env (never commit .env).

# --- Archive indexer (scripts/drive-index.mjs, runs on `npm run data:archive` and before every build) ---
# Google API key with the Drive API enabled. Enough because the root folder is "anyone with link: viewer".
# Without a key the build reuses the committed data/drive-files.json snapshot (or the sample fixture).
GOOGLE_API_KEY=
# Optional alternative to the API key: a service-account JSON (one line). Needs `npm i -D google-auth-library`.
GOOGLE_SERVICE_ACCOUNT_JSON=
# "Mesac-Academics" root folder.
DRIVE_ROOT_ID=1O_Q5coUAKKpSu3Egmz5YOu9MzdPxyiR6

# --- Archive UI (public, bundled into the site) ---
# Google Form for "Report a problem" (use the form's /viewform URL).
# If unset, the button opens an email to mesacusatacademy@gmail.com instead.
VITE_REPORT_FORM_URL=
# Prefilled field id for the document, e.g. entry.123456789
VITE_REPORT_FORM_FILE_ENTRY=

# --- Site content from Google Sheets (scripts/sheet-sync.mjs, runs on `npm run data:sheet` and before every build) ---
# In the Sheet: File > Share > Publish to web > choose ONE tab > "Comma-separated values (.csv)" > Publish.
# Paste each tab's URL below. No API key needed. Tabs and columns:
#   team:         name, role, group, photo, linkedin, email_public, order, visible
#   achievements: title, date, category, description, image, link, order, visible
#   placements:   name, company, role, batch, photo, linkedin, order, visible
#   alumni:       name, batch, department, current_role, company, location, photo, linkedin, email_public,
#                 phone_public, help_with, consent, order, visible
#                 (only rows with consent TRUE are shown, but a published CSV exposes every row: see HANDOVER.md)
#   settings:     key, value
# Without these the build keeps the committed snapshot (sample data until you set them).
SHEET_TEAM_CSV=
SHEET_ACHIEVEMENTS_CSV=
SHEET_PLACEMENTS_CSV=
SHEET_ALUMNI_CSV=
SHEET_SETTINGS_CSV=

# Set DEPLOY=1 when running `npm run check:deploy` in CI to refuse sample data.

# --- Admin dashboard (optional; see docs/OWNER-DEPLOYMENT-GUIDE.md) ---
# Normally set only as GitHub secrets. With D1_DATABASE_ID set, `npm run build` adds the database, photo store and
# Access settings to .output/server/wrangler.json. Leave them empty to keep the Sheet-only site.
D1_DATABASE_ID=
R2_BUCKET_NAME=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Local development only: `ADMIN_DEV_EMAIL=you@example.com npm run dev:admin` (see HANDOVER.md section 4).

# --- Public address of the site (canonical links, og:url, sitemap.xml, robots.txt) ---
# Until you have a custom domain, use the Worker address Cloudflare shows after the first deploy
# (https://mesac-cusat.<your-subdomain>.workers.dev). Update it when the domain changes.
# Left empty, the build uses the placeholder https://mesac.example and `DEPLOY=1 npm run check:deploy` fails.
SITE_URL=
