# Application Environment Variables
# Example:
# VITE_APP_URL=http://localhost:3000

# Copy to .env (never commit .env).

# --- Archive indexer (scripts/drive-index.mjs, runs on `npm run data:archive` and before every build) ---
# Google API key with the Drive API enabled. Enough because the root folder is "anyone with link: viewer".
# Without a key the build reuses the committed data/drive-files.json snapshot (or the sample fixture).
GOOGLE_API_KEY=
# Optional alternative to the API key: a service-account JSON (one line). Needs `npm i -D google-auth-library`.
GOOGLE_SERVICE_ACCOUNT_JSON=
# "Mesac-Academics" root folder.
DRIVE_ROOT_ID=1O_Q5coUAKKpSu3Egmz5YOu9MzdPxyiR6

# --- Archive UI (public, bundled into the site) ---
# Google Form for "Report a problem" (use the form's /viewform URL).
# If unset, the button opens an email to mesacusatacademy@gmail.com instead.
VITE_REPORT_FORM_URL=
# Prefilled field id for the document, e.g. entry.123456789
VITE_REPORT_FORM_FILE_ENTRY=
